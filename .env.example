# ========================================================
# Deptloy Server-Side Gmail Configuration
# ========================================================
# These variables are accessed ONLY on the server via Next.js
# route handlers and are never exposed to client-side code.
# Never commit your actual .env.local file to git.
# --------------------------------------------------------

# 1. Your Gmail address used to authenticate and send emails:
GMAIL_USER=your-email@gmail.com

# 2. Your 16-character Google App Password (NOT your regular Gmail password)
# How to obtain:
#   a. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
#   b. Navigate to: https://myaccount.google.com/apppasswords
#   c. Create a new App Password (e.g. name it "Deptloy Website")
#   d. Copy the 16-character code (spaces will be automatically stripped):
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 3. Destination email address where inquiries should be delivered:
# (Defaults to GMAIL_USER or deptloy@gmail.com if not specified)
CONTACT_EMAIL=deptloy@gmail.com
