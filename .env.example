# Deptloy Email Configuration
# Quote requests are routed to this recipient:
CONTACT_EMAIL=deptloy@gmail.com

# OPTION 1: Resend API (Recommended for production on Vercel / Cloudflare)
# Sign up at https://resend.com, grab your API key, and set:
# RESEND_API_KEY=re_123456789
# EMAIL_FROM=Deptloy <quotes@deptloy.com>

# OPTION 2: Gmail SMTP / Google App Password (Zero third-party setup)
# 1. Enable 2-Step Verification on your deptloy@gmail.com Google Account
# 2. Visit: https://myaccount.google.com/apppasswords
# 3. Create a 16-character App Password (e.g. named "Deptloy Website")
# 4. Fill in below:
GMAIL_USER=deptloy@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
SMTP_SERVICE=gmail
