# ========================================================
# Deptloy Server-Side Gmail Configuration
# ========================================================
# These variables are accessed ONLY on the server via Next.js
# route handlers and are never exposed to client-side code.
# Never commit your actual .env.local file to git.
# --------------------------------------------------------

# 1. Your Gmail address used to authenticate and send emails:
GMAIL_USER=your-email@gmail.com

# 2. Your 16-character Google App Password (NOT your regular Gmail password)
# How to obtain:
#   a. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
#   b. Navigate to: https://myaccount.google.com/apppasswords
#   c. Create a new App Password (e.g. name it "Deptloy Website")
#   d. Copy the 16-character code (spaces will be automatically stripped):
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 3. Destination email address where inquiries should be delivered:
# (Defaults to GMAIL_USER or deptloy@gmail.com if not specified)
CONTACT_EMAIL=deptloy@gmail.com

# ========================================================
# Live Voice Demo (/demo) — Gemini Live + abuse protection
# ========================================================

# Gemini API key from https://aistudio.google.com/apikey (server only, never sent to the browser).
GEMINI_API_KEY=
# Optional. Live model to use (default: gemini-3.8-live).
# GEMINI_LIVE_MODEL=gemini-3.8-live

# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile). Add deptloy.com as a hostname.
# For local testing, Cloudflare's test keys always pass:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis for rate-limit counters. Adding Upstash from the Vercel Marketplace sets
# KV_REST_API_URL / KV_REST_API_TOKEN automatically; UPSTASH_REDIS_REST_URL / _TOKEN also work.
# Optional in local dev (an in-memory store is used); required in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. Comma-separated origins allowed to start calls.
# Default: https://deptloy.com,https://www.deptloy.com (+ this Vercel deployment's own URLs).
# VOICE_DEMO_ALLOWED_ORIGINS=https://deptloy.com,https://www.deptloy.com

# Optional limits (defaults shown). Gemini's free tier allows about 3 live calls at once per project;
# check your real limits at https://aistudio.google.com/rate-limit and keep these at or below them.
# VOICE_DEMO_MAX_PER_HOUR=3            # calls per IP per hour
# VOICE_DEMO_MAX_PER_DAY=10            # calls per IP per day
# VOICE_DEMO_STRIKES_BEFORE_BLOCK=3    # limit hits / failed human checks before a block
# VOICE_DEMO_BLOCK_SECONDS=3600        # block length
# VOICE_DEMO_MAX_CALL_SECONDS=180      # hard call length (the Gemini token expires then)
# VOICE_DEMO_SILENCE_SECONDS=20        # hang up after this much silence
# VOICE_DEMO_MAX_CONCURRENT=3          # calls at once across the site
# VOICE_DEMO_DAILY_MINUTES=60          # call minutes per day across the site (resets midnight Pacific)
